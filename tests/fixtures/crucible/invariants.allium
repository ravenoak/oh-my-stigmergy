-- allium: 3
-- Repository governance: traceability row maturity (FR-1.1 domain slice).

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

entity TraceabilityRow {
    requirement_id: String
    maturity: draft | published

    transitions maturity {
        draft -> published
        terminal: published
    }
}

entity Pheromone {
    id: String
    state: open | claimed | done | expired
    stance_target: String

    transitions state {
        open -> claimed
        claimed -> done
        open -> expired
        terminal: done
        terminal: expired
    }
}

entity StanceTarget {
    name: String
}

entity LedgerStore {
    kind: memory | jsonl | sqlite
}

entity CodeCard {
    role: line | symbol | method | decorator
    language: python | typescript | shell
}

entity AspectEdge {
    kind: imports | sources | calls
}

entity RepositoryGovernance {
    charter_status: draft | amended | frozen

    transitions charter_status {
        draft -> amended
        amended -> frozen
        terminal: frozen
    }
}

entity DistillationArtefact {
    kind: spec | delta | gap
    lifecycle: draft | published
}

entity ShimAllowEntry {
    attestation: attested | tampered
}

entity WorkflowJob {
    id: filter | governance | specs_and_packages | check
    outcome: pending | success | failure | skipped
}

------------------------------------------------------------
-- Defaults
------------------------------------------------------------

default TraceabilityRow seed_traceability_row = {
    requirement_id: "FR-0.2",
    maturity: draft
}

default Pheromone seed_pheromone = {
    id: "demo-pheromone",
    state: open,
    stance_target: "feature_implementation"
}

default LedgerStore seed_ledger_store = {
    kind: memory
}

default StanceTarget seed_stance_target = {
    name: "feature_implementation"
}

default CodeCard seed_code_card = {
    role: line,
    language: python
}

default AspectEdge seed_aspect_edge = {
    kind: imports
}

default RepositoryGovernance seed_repository_governance = {
    charter_status: draft
}

default DistillationArtefact seed_distillation_artefact = {
    kind: spec,
    lifecycle: draft
}

default ShimAllowEntry seed_shim_allow_entry = {
    attestation: attested
}

default WorkflowJob seed_workflow_job = {
    id: governance,
    outcome: success
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant TraceabilityRowsWellFormed {
    for row in TraceabilityRows:
        length(row.requirement_id) > 0 and (row.maturity = draft or row.maturity = published)
}

invariant PheromonesWellFormed {
    for p in Pheromones:
        length(p.id) > 0
            and (p.state = open or p.state = claimed or p.state = done or p.state = expired)
            and length(p.stance_target) > 0
}

invariant StanceTargetsWellFormed {
    for s in StanceTargets:
        length(s.name) > 0
}

invariant LedgerStoresWellFormed {
    for ls in LedgerStores:
        ls.kind = memory or ls.kind = jsonl or ls.kind = sqlite
}

invariant CodeCardsWellFormed {
    for c in CodeCards:
        (c.role = line or c.role = symbol or c.role = method or c.role = decorator)
            and (c.language = python or c.language = typescript or c.language = shell)
}

invariant AspectEdgesWellFormed {
    for e in AspectEdges:
        e.kind = imports or e.kind = sources or e.kind = calls
}

invariant RepositoryGovernancesWellFormed {
    for r in RepositoryGovernances:
        r.charter_status = draft or r.charter_status = amended or r.charter_status = frozen
}

invariant DistillationArtefactsWellFormed {
    for d in DistillationArtefacts:
        (d.kind = spec or d.kind = delta or d.kind = gap)
            and (d.lifecycle = draft or d.lifecycle = published)
}

invariant ShimAllowEntriesWellFormed {
    for s in ShimAllowEntries:
        s.attestation = attested or s.attestation = tampered
}

invariant WorkflowJobsWellFormed {
    for w in WorkflowJobs:
        (w.id = filter or w.id = governance or w.id = specs_and_packages or w.id = check)
            and (w.outcome = pending or w.outcome = success or w.outcome = failure or w.outcome = skipped)
}
