{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(allium check *)",
      "Bash(allium analyse *)",
      "Bash(bash scripts/check-allium-specs.sh*)",
      "Bash(bash scripts/analyse-allium-specs.sh*)",
      "Bash(bash tests/ci_contract.sh*)",
      "Bash(bash scripts/verify-requirement-traceability.sh*)",
      "Bash(bash scripts/verify-governance-doc-cotouch.sh*)",
      "Bash(gh pr *)",
      "Bash(gh auth status*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(git merge-base *)",
      "Bash(uv run *)",
      "Bash(uv sync *)",
      "Bash(uv lock *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/allium-check.sh",
            "timeout": 30000
          }
        ]
      }
    ]
  }
}
